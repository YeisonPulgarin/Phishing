# Plantilla de configuración. Copiá este archivo a `.env` y completá con tus valores.
# NO commiteés tu `.env` real.

# Claves de API válidas (separadas por coma). Usá una clave distinta por entorno.
# En desarrollo podés dejarla acá; rotá antes de producción.
PD_API_KEYS=dev-key

# Ruta de la base SQLite.
# PD_DB_PATH=phishing.db

# Claves de conectores opcionales. Si se omiten, degradan a "no disponible".
# PD_GSB_API_KEY=
# PD_VT_API_KEY=

# Rutas de datos versionados.
# PD_MODEL_PATH=data/model.joblib
# PD_DATASET_PATH=data/dataset

# Dominios propios (los de tu servidor de correo interno), separados por coma. Un correo que
# venga de aquí no se castiga por "no existir en el DNS público": es correo interno legítimo.
# PD_TRUSTED_DOMAINS=correo.local

# --- Bandeja: buzón IMAP de tu propio servidor de correo (Postfix/Dovecot) ---
# Si se dejan vacías, la pestaña Bandeja queda desactivada y el resto funciona igual.
# PD_IMAP_HOST=192.168.56.10
# PD_IMAP_PORT=143
# PD_IMAP_USER=usuario1
# PD_IMAP_PASSWORD=correo123
# PD_IMAP_SSL=false
# PD_IMAP_MAILBOX=INBOX
# Carpeta a la que se mueven los correos marcados como phishing.
# PD_IMAP_QUARANTINE=Phishing
