# Plantilla de configuración. Copiá este archivo a `.env` y completá con tus valores.
# NO commiteés tu `.env` real.

# Claves de API válidas (separadas por coma). Usá una clave distinta por entorno.
# En desarrollo podés dejarla acá; rotá antes de producción.
PD_API_KEYS=dev-key

# Ruta de la base SQLite.
# PD_DB_PATH=phishing.db

# Claves de conectores opcionales. Si se omiten, degradan a "no disponible".
# PD_GSB_API_KEY=
# PD_VT_API_KEY=

# Rutas de datos versionados.
# PD_MODEL_PATH=data/model.joblib
# PD_DATASET_PATH=data/dataset
